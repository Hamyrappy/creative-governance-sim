@article{grimm2006odd,
  title   = {A standard protocol for describing individual-based and agent-based models},
  author  = {Grimm, Volker and Berger, Uta and Bastiansen, Finn and Eliassen, Sigrunn and
             Ginot, Vincent and Giske, Jarl and Goss-Custard, John and Grand, Tamara and
             Heinz, Simone K. and Huse, Geir and Huth, Andreas and Jepsen, Jane U. and
             J{\o}rgensen, Christian and Mooij, Wolf M. and M{\"u}ller, Birgit and Pe'er, Guy and
             Piou, Cyril and Railsback, Steven F. and Robbins, Andrew M. and Robbins, Martha M. and
             Rossmanith, Eva and R{\"u}ger, Nadja and Strand, Espen and Souissi, Sami and
             Stillman, Richard A. and Vab{\o}, Rune and Visser, Ute and DeAngelis, Donald L.},
  journal = {Ecological Modelling},
  volume  = {198},
  number  = {1--2},
  pages   = {115--126},
  year    = {2006},
  doi     = {10.1016/j.ecolmodel.2006.04.023},
  note    = {Verified 2026-08-05: title, complete 28-author list, journal, volume 198(1--2),
             pages 115--126 and DOI read on the KNAW Pure landing page for the article
             (pure.knaw.nl/portal/en/publications/c7aee8e0-f02f-45e7-a8fd-d2824f299c4e) and
             re-checked against the publisher-deposited Crossref record for
             doi:10.1016/j.ecolmodel.2006.04.023, which returns the same title, venue,
             volume/issue/pages and author order. The paper introduces ODD, a protocol drafted
             and tested by 28 modellers that fixes a three-block (Overview, Design concepts,
             Details) / seven-element order for describing individual- and agent-based models,
             its stated aim being to make such models understandable and reproducible rather
             than to prescribe how they are built.}
}

@article{grimm2010oddupdate,
  title   = {The {ODD} protocol: A review and first update},
  author  = {Grimm, Volker and Berger, Uta and DeAngelis, Donald L. and Polhill, J. Gary and
             Giske, Jarl and Railsback, Steven F.},
  journal = {Ecological Modelling},
  volume  = {221},
  number  = {23},
  pages   = {2760--2768},
  year    = {2010},
  doi     = {10.1016/j.ecolmodel.2010.08.019},
  note    = {Verified 2026-08-05: title, six-author list, Ecological Modelling 221(23):2760--2768,
             DOI and abstract read on the RePEc/IDEAS listing for the article
             (ideas.repec.org/a/eee/ecomod/v221y2010i23p2760-2768.html), then confirmed against the
             publisher-deposited Crossref record for doi:10.1016/j.ecolmodel.2010.08.019 (issued
             2010-11), which prints the fourth author as "J. Gary Polhill" -- note that the same
             person appears as "J. Gareth Polhill" on the 2020 update, so the differing forms here
             are correct-as-published, not a transcription slip. The paper reviews every published
             use of ODD up to December 2009 and revises the protocol accordingly; the most visible
             change is that the 2006 element "State variables and scales" becomes "Entities, state
             variables and scales". It also reports an unanticipated benefit: writing ODD forces
             more rigorous model formulation and exposes a model's theoretical foundations.}
}

@article{grimm2020odd,
  title   = {The {ODD} Protocol for Describing Agent-Based and Other Simulation Models:
             A Second Update to Improve Clarity, Replication, and Structural Realism},
  author  = {Grimm, Volker and Railsback, Steven F. and Vincenot, Christian E. and Berger, Uta and
             Gallagher, Cara and DeAngelis, Donald L. and Edmonds, Bruce and Ge, Jiaqi and
             Giske, Jarl and Groeneveld, J{\"u}rgen and Johnston, Alice S. A. and Milles, Alexander
             and Nabe-Nielsen, Jacob and Polhill, J. Gareth and Radchuk, Viktoriia and
             Rohw{\"a}der, Marie-Sophie and Stillman, Richard A. and Thiele, Jan C. and
             Ayll{\'o}n, Daniel},
  journal = {Journal of Artificial Societies and Social Simulation},
  volume  = {23},
  number  = {2},
  pages   = {7},
  year    = {2020},
  doi     = {10.18564/jasss.4259},
  note    = {Verified 2026-08-05: read on the journal's own page, jasss.org/23/2/7.html -- title,
             byline, JASSS 23(2), article 7, DOI 10.18564/jasss.4259, received 08-Nov-2019,
             accepted 16-Feb-2020, published 31-Mar-2020 -- and the page's own "how to cite" block.
             Two surnames were adjudicated because the HTML byline is easy to misread: the journal's
             citation block, the Aarhus University and Bournemouth University repository records,
             and the publisher-deposited Crossref record for doi:10.18564/jasss.4259 all agree on
             "Milles, Alexander" and "Rohw{\"a}der, Marie-Sophie". The paper is the current version
             of ODD: it adds "patterns" to the Purpose element (state the criteria under which the
             model is realistic enough for its purpose), gives guidance for structuring long ODDs
             and for an ODD summary inside a journal article, presses authors to link the written
             description to the code, and argues that simulation experiments themselves need a
             standard description.}
}

@article{muller2013oddd,
  title   = {Describing human decisions in agent-based models -- {ODD} + {D},
             an extension of the {ODD} protocol},
  author  = {M{\"u}ller, Birgit and Bohn, Friedrich and Dre{\ss}ler, Gunnar and
             Groeneveld, J{\"u}rgen and Klassert, Christian and Martin, Romina and
             Schl{\"u}ter, Maja and Schulze, Jule and Weise, Hanna and Schwarz, Nina},
  journal = {Environmental Modelling \& Software},
  volume  = {48},
  pages   = {37--48},
  year    = {2013},
  doi     = {10.1016/j.envsoft.2013.06.003},
  note    = {Verified 2026-08-05: record read on the University of Twente research portal
             (research.utwente.nl/en/publications/describing-human-decisions-in-agent-based-models-odd-d-an-extensi/)
             giving Environmental Modelling \& Software 48:37--48, 2013, DOI
             10.1016/j.envsoft.2013.06.003; the full ten-author list with complete first names and
             the exact title were taken from the publisher-deposited Crossref record for that DOI
             (the Twente page truncates the title at "protoc" and abbreviates given names). The
             paper argues that ABM documentation routinely fails to justify, empirically or
             theoretically, why a particular model of human decision-making was chosen, and adds a
             decision block to ODD -- theoretical and empirical background, individual
             decision-making, learning, individual sensing and prediction -- to force that
             justification into the model description.}
}

